# ─────────────────────────────────────────────────────────────
# DAO MARKETING — environment template.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# Microsoft 365 SMTP relay (used by /api/contact via nodemailer)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=fraz@daomarketing.com
SMTP_PASS=                # mailbox password OR app password if 2FA is on
CONTACT_TO=fraz@daomarketing.com

# Google Analytics 4 — used by @next/third-parties/GoogleAnalytics
# Public env (NEXT_PUBLIC_ prefix) so the gtag.js loader runs client-side.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==================== SUPABASE PORTAL ====================
# Get from Supabase Dashboard → Project Settings → API
# Project: dao-marketing-portal (https://supabase.com)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here_NEVER_COMMIT
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000/portal